{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "memento3d-fronted-web",
  "compatibility_date": "2026-10-12",
  "observability": {
    "enabled": true
  },
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "previews": {}
}
