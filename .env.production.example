# ==============================================================================
# MEMENTO3D FRONTEND — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# In Cloudflare Workers / Cloudflare Pages, configure these in:
# Settings > Variables and Secrets > Production Environment Variables
# ==============================================================================

# Backend REST API Base URL
# If hosting Frontend on Cloudflare and Backend on VPS / Neon / Railway / AWS:
# Point directly to your backend domain (e.g. https://api.memento3d.com/api/v1)
VITE_API_BASE_URL=https://api.memento3d.com/api/v1

# Google OAuth2 Client ID for Customer & Staff Single Sign-On
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
